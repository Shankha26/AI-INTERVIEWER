# PrepAI Pro - Local Environment Variable Template
# Copy this file to .env and fill in your values.

SECRET_KEY=prepai_pro_super_secret_key_1337_abc!

# MySQL Connection Details
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=prepai_pro

# Google Gemini API Key
# If left blank, the system automatically runs in Mock/Simulation Mode.
GEMINI_API_KEY=
